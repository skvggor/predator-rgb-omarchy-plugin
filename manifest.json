{
  "schemaVersion": 1,
  "id": "skvggor.predator-rgb",
  "name": "Predator RGB",
  "version": "0.2.1",
  "author": "skvggor",
  "license": "GPL-3.0",
  "description": "Syncs the Acer Predator Helios Neo 16 keyboard backlight and back logo with the active Omarchy theme accent color.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Predator RGB",
    "description": "Show the keyboard LED status and apply the current theme accent color to keyboard and back logo.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "brightness": 100,
      "backLogoEnabled": true
    },
    "schema": [
      {
        "key": "brightness",
        "type": "integer",
        "label": "LED brightness (%)",
        "min": 0,
        "max": 100,
        "step": 1,
        "defaultValue": 100
      },
      {
        "key": "backLogoEnabled",
        "type": "boolean",
        "label": "Enable back logo LED",
        "defaultValue": true
      }
    ]
  }
}
