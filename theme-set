#!/bin/bash
# omarchy:summary=Apply the current Omarchy theme accent color to the Acer Predator RGB keyboard and back logo
#
# Reads the theme accent color (keyboard.rgb) that Omarchy writes on every theme
# change and applies it as a static color at 100% brightness. Runs as a
# theme-set.d hook, but can also be invoked directly.
#
# REQUIRES: acer_rgb kernel module (included in this plugin)

set -euo pipefail

ACER_RGB_SYSFS="${ACER_RGB_SYSFS:-/sys/devices/platform/acer_rgb/four_zoned_kb/per_zone_mode}"
BACK_LOGO_SYSFS="${BACK_LOGO_SYSFS:-/sys/devices/platform/acer_rgb/four_zoned_kb/back_logo}"
KEYBOARD_RGB_FILE="${PREDATOR_RGB_KEYBOARD_RGB_FILE:-$HOME/.local/state/omarchy/current/theme/keyboard.rgb}"
BRIGHTNESS="${PREDATOR_RGB_BRIGHTNESS:-100}"
BACK_LOGO_ENABLED="${PREDATOR_RGB_BACK_LOGO:-true}"

if [[ ! "$BRIGHTNESS" =~ ^[0-9]+$ ]] || (( BRIGHTNESS < 0 || BRIGHTNESS > 100 )); then
  echo "predator-rgb: invalid brightness \"$BRIGHTNESS\", falling back to 100" >&2
  BRIGHTNESS=100
fi

if [[ "$BACK_LOGO_ENABLED" == "true" || "$BACK_LOGO_ENABLED" == "1" ]]; then
  BACK_LOGO_ENABLED="true"
elif [[ "$BACK_LOGO_ENABLED" == "false" || "$BACK_LOGO_ENABLED" == "0" ]]; then
  BACK_LOGO_ENABLED="false"
else
  echo "predator-rgb: invalid back logo flag \"$BACK_LOGO_ENABLED\", falling back to true" >&2
  BACK_LOGO_ENABLED="true"
fi

validate_hex_color() {
  local hex=$1
  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]]
}

read_accent_hex() {
  local content
  content=$(sed 's/^[[:space:]]*#\?//; s/[[:space:]]*$//' "$KEYBOARD_RGB_FILE")
  if validate_hex_color "$content"; then
    printf "%s" "$content"
  fi
}

apply_theme_color() {
  local hex
  hex=$(read_accent_hex)
  [[ -n $hex ]] || return 0

  # Apply same color to all 4 zones at specified brightness
  echo "${hex},${hex},${hex},${hex},${BRIGHTNESS}" > "$ACER_RGB_SYSFS" 2>/dev/null

  # Apply to back logo if enabled
  if [[ "$BACK_LOGO_ENABLED" == "true" ]]; then
    local enable=1
    echo "${hex},${BRIGHTNESS},${enable}" > "$BACK_LOGO_SYSFS" 2>/dev/null
  else
    echo "${hex},${BRIGHTNESS},0" > "$BACK_LOGO_SYSFS" 2>/dev/null
  fi
}

main() {
  local sysfs_dir
  sysfs_dir=$(dirname "$ACER_RGB_SYSFS")
  [[ -d "$sysfs_dir" ]] || exit 0
  [[ -w $ACER_RGB_SYSFS ]] || exit 0
  [[ -r $KEYBOARD_RGB_FILE ]] || exit 0
  apply_theme_color
  omarchy-shell -q skvggor.predator-rgb refresh 2>/dev/null || true
}

main
